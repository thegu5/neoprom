{
	"name": "@gu5/neoprom",
	"version": "0.2.0",
	"description": "A modern TypeScript-first client library for Prometheus",
	"author": "Gus",
	"license": "MIT",
	"homepage": "https://github.com/thegu5/neoprom",
	"bugs": {
		"url": "https://github.com/thegu5/neoprom/issues"
	},
	"repository": "git+https://github.com/thegu5/neoprom.git",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./hono": {
			"import": {
				"types": "./dist/middleware/hono.d.ts",
				"default": "./dist/middleware/hono.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"test": "node --test **/*.test.ts",
		"test:integrated": "nix-build ./test/integrated/prometheus-scrape.nix"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.0.0 <13.0.0",
			"onFail": "download"
		}
	},
	"peerDependencies": {
		"hono": "^4.13.13"
	},
	"peerDependenciesMeta": {
		"hono": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@hono/node-server": "^2.1.5",
		"@types/node": "^26.6.6",
		"hono": "^4.13.14",
		"typescript": "^7.0.2"
	}
}
